# ==============================================================================
# CodeSentinel AI Commercial Platform - Production Environment Template
# ==============================================================================

# Core Application Settings
APP_NAME="CodeSentinel AI Commercial"
APP_ENV="production"
DEBUG=false
API_V1_STR="/api/v1"
CORS_ORIGINS='["https://app.codesentinel.ai", "https://api.codesentinel.ai"]'

# Database & Storage
POSTGRES_DB="codesentinel_commercial"
POSTGRES_USER="codesentinel_user"
POSTGRES_PASSWORD="change_me_super_secure_postgres_password_2026"
DATABASE_URL="postgresql+asyncpg://codesentinel_user:change_me_super_secure_postgres_password_2026@postgres:5432/codesentinel_commercial"

# Redis & Celery Queues
REDIS_PASSWORD="change_me_super_secure_redis_password_2026"
REDIS_URL="redis://:change_me_super_secure_redis_password_2026@redis:6379/0"
CELERY_BROKER_URL="redis://:change_me_super_secure_redis_password_2026@redis:6379/1"
CELERY_RESULT_BACKEND="redis://:change_me_super_secure_redis_password_2026@redis:6379/2"

# Security & Encryption (Envelope Master Key)
FERNET_MASTER_KEY="generate_using_python_cryptography_Fernet_generate_key"
JWT_SECRET="generate_64_char_secure_random_string_for_jwt_signing"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# S3 / MinIO Object Storage
S3_ENDPOINT_URL="http://minio:9000"
MINIO_ROOT_USER="codesentinel_minio_admin"
MINIO_ROOT_PASSWORD="change_me_super_secure_minio_password_2026"
S3_ACCESS_KEY="codesentinel_minio_admin"
S3_SECRET_KEY="change_me_super_secure_minio_password_2026"
S3_BUCKET_NAME="codesentinel-artifacts"
S3_REGION="us-east-1"

# GitHub App Integration
GITHUB_APP_ID="123456"
GITHUB_APP_CLIENT_ID="Iv1.xxxxxxxxxxxx"
GITHUB_APP_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_APP_WEBHOOK_SECRET="generate_secure_random_webhook_secret_string"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Stripe SaaS Billing & Entitlements
STRIPE_API_KEY="sk_live_replace_with_actual_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_actual_stripe_signing_secret"
STRIPE_PRICE_TEAM_MONTHLY="price_1Nxxxxxxxxxxxx"
STRIPE_PRICE_TEAM_YEARLY="price_1Nyyyyyyyyyyyy"
